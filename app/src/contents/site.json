    "content": {
      "hero": {
        "title": "Compose systems.",
        "lede": "From in-process supervision to agents and central control.",
        "loading": "Loading Solti",
        "labels": {
          "podium": "Podium",
          "sdk": "SDK",
          "taskvisor": "Taskvisor"
        }
      },
      "composition": {
        "eyebrow": "How it composes",
        "title": "One operating model. Three explicit boundaries.",
        "lede": "The stack separates system coordination, agent behavior, and in-process lifecycle. Each boundary has a distinct contract and a distinct integration model.",
        "levels": [
          {
            "index": "01",
            "scope": "Control-plane project",
            "product": "Podium",
            "title": "Coordinate agents and per-agent rollouts.",
            "body": "An early Go control-plane project for agent discovery, task specifications, and per-agent rollout state. Its versioned agent integration is still evolving.",
            "action": "View Podium source ↗",
            "href": "https://github.com/soltiHQ/podium"
          },
          {
            "index": "02",
            "scope": "Agent SDK",
            "product": "SDK",
            "title": "Build your own task-execution agent.",
            "body": "Composable Rust crates provide Task resources, workload routing, desired-state reconciliation, execution backends, and optional HTTP or gRPC APIs. Your team selects the components and owns configuration, deployment, and the final security boundary.",
            "action": "Explore the SDK ↗",
            "href": "https://github.com/soltiHQ/sdk"
          },
          {
            "index": "03",
            "scope": "In-process Rust library",
            "product": "Taskvisor",
            "title": "Supervise Tokio work in-process.",
            "body": "A Rust library for retries, backoff, attempt timeouts, cancellation, and graceful shutdown. Watched tasks return direct final outcomes; optional per-key admission can queue, replace, or reject competing work.",
            "action": "Explore Taskvisor ↗",
            "href": "https://github.com/soltiHQ/taskvisor"
          }
        ]
      },
      "proof": {
        "eyebrow": "A real Task",
        "title": "Desired state in. Runtime state out.",
        "lede": "Start with the smallest useful workload: one subprocess Task. The SDK commits desired state, routes it to a registered runner, uses Taskvisor to supervise the attempt, and exposes reconciliation, live output, terminal state, and bounded run history.",
        "manifest": {
          "index": "01",
          "label": "Task manifest",
          "filename": "task_subprocess.rs",
          "lines": [
            "let workload = TaskWorkload::Subprocess(",
            "    SubprocessSpec::new(",
            "        SubprocessMode::Command {",
            "            command,",
            "            args: vec![CHILD_MODE.into(), child_address],",
            "        },",
            "        TaskEnv::new(),",
            "        None,",
            "        Flag::enabled(),",
            "    ),",
            ");",
            "",
            "let spec = TaskSpec::builder(\"example\", workload, 30_000_u64)",
            "    .restart(RestartPolicy::Never)",
            "    .build()?;",
            "let manifest = TaskManifest::new(\"subprocess-example\", spec)?;",
            "",
            "let committed = supervisor.create_task(manifest).await?;"
          ]
        },
        "trace": {
          "index": "02",
          "label": "Observed lifecycle",
          "source": "task_subprocess",
          "command": "$ cargo run -p solti --example task_subprocess --features core,exec-subprocess",
