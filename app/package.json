{
  "name": "@soltihq/site-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build && npm run docs:catalog",
    "docs:catalog": "node scripts/prepare-docs-catalog.mjs",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:test": "node scripts/test-docs-renderer.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "type-check": "vue-tsc --build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/vue": "1.33.0",
    "vue": "3.5.18",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.2",
    "@types/node": "24.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.7.0",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitepress": "2.0.0-alpha.15",
    "vue-tsc": "3.0.4",
    "yaml": "2.9.0"
  }
}
